{
  "name": "@uploadcare/ai-enhancer",
  "version": "0.1.1",
  "description": "AI image generation and editing web component for Uploadcare",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/ai-enhancer.cjs",
  "module": "./dist/ai-enhancer.js",
  "types": "./dist/ai-enhancer.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ai-enhancer.d.ts",
      "import": "./dist/ai-enhancer.js",
      "require": "./dist/ai-enhancer.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "cem analyze && node scripts/build-cem-docs.mjs && typedoc && node scripts/clean-typedoc-class.mjs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lit-labs/motion": "^1.1.0",
    "@uploadcare/cdn-url": "6.19.0-alpha.0",
    "@uploadcare/cname-prefix": "^6.18.4",
    "@uploadcare/upload-client": "^6.18.4",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "@uploadcare/file-uploader": ">=1.31.2"
  },
  "peerDependenciesMeta": {
    "@uploadcare/file-uploader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@custom-elements-manifest/to-markdown": "^0.1.0",
    "@uploadcare/file-uploader": "1.31.2",
    "@vitest/browser-playwright": "^4.1.10",
    "playwright": "^1.49.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "vitepress": "^1.6.4",
    "zod": "^3.25.76"
  },
  "keywords": [
    "uploadcare",
    "ai",
    "image-generation",
    "image-editing",
    "web-component",
    "lit",
    "uploader-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uploadcare/ai-enhancer.git",
    "directory": "packages/ai-enhancer"
  },
  "author": "Uploadcare",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "customElements": "docs/api/custom-elements.json"
}
