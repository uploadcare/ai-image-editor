{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The published types, not the source: these tests speak for whoever
    // installs the package, and `@uploadcare/ai-image-editor` resolves to its
    // `dist/*.d.ts` the same way it does for them. Run `npm run build` in that
    // package first.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["tests/types", "src"]
}
