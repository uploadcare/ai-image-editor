{
  "name": "@uploadcare/ai-image-editor",
  "version": "0.2.2",
  "description": "AI image generation and editing web component for Uploadcare: create images from text prompts, enhance and edit existing ones, and plug into the Uploadcare File Uploader.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/ai-image-editor.cjs",
  "module": "./dist/ai-image-editor.js",
  "types": "./dist/ai-image-editor.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ai-image-editor.d.ts",
      "import": "./dist/ai-image-editor.js",
      "require": "./dist/ai-image-editor.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:api": "cem analyze && node scripts/build-cem-docs.mjs && typedoc && node scripts/clean-typedoc-class.mjs",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "site:build": "npm run docs:build && npm run playground:build",
    "playground:build": "vite build --mode demo --outDir ../docs/.vitepress/dist/playground --base ${DOCS_BASE:-/ai-image-editor/}playground/",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "lint:lit": "lit-analyzer './src/**/*.ts' --strict --rules.no-unknown-attribute off"
  },
  "dependencies": {
    "@lit-labs/motion": "^1.1.0",
    "@uploadcare/cdn-url": "6.19.0-alpha.0",
    "@uploadcare/cname-prefix": "^6.18.4",
    "@uploadcare/upload-client": "^6.18.4",
    "lit": "^3.2.1"
  },
  "peerDependencies": {
    "@uploadcare/file-uploader": ">=1.31.2"
  },
  "peerDependenciesMeta": {
    "@uploadcare/file-uploader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@custom-elements-manifest/to-markdown": "^0.1.0",
    "@uploadcare/file-uploader": "1.31.2",
    "@vitest/browser-playwright": "^4.1.10",
    "lit-analyzer": "^2.0.3",
    "playwright": "^1.49.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "vitepress": "^1.6.4",
    "zod": "^3.25.76"
  },
  "keywords": [
    "uploadcare",
    "ai",
    "ai-image-generator",
    "ai-image-editor",
    "image-generation",
    "image-editing",
    "image-enhancement",
    "text-to-image",
    "web-component",
    "custom-element",
    "lit",
    "shadow-dom",
    "file-uploader",
    "uploader-plugin",
    "image-upload",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uploadcare/ai-image-editor.git",
    "directory": "packages/ai-image-editor"
  },
  "author": {
    "name": "Uploadcare",
    "url": "https://uploadcare.com"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "customElements": "docs/api/custom-elements.json",
  "homepage": "https://uploadcare.github.io/ai-image-editor/",
  "bugs": "https://github.com/uploadcare/ai-image-editor/issues"
}
