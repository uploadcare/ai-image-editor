{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "packages/ai-image-editor": {
      "component": "ai-image-editor"
    },
    "packages/react-ai-image-editor": {
      "component": "react-ai-image-editor"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "ai-image-editor",
      "components": ["ai-image-editor", "react-ai-image-editor"]
    }
  ]
}
