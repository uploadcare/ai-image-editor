{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "packages/ai-enhancer": {
      "component": "ai-enhancer"
    },
    "packages/react-ai-enhancer": {
      "component": "react-ai-enhancer"
    }
  },
  "plugins": [
    {
      "type": "node-workspace",
      "merge": false
    },
    {
      "type": "linked-versions",
      "groupName": "ai-enhancer",
      "components": ["ai-enhancer", "react-ai-enhancer"]
    }
  ]
}
